  "scripts": {
    "build": "tsc -b",
    "start": "node ./dist/main.js"
  },
  "dependencies": {
    "@anthias/agent": "workspace:*",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "string-width": "8.2.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
